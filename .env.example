# 环境变量配置示例
# 复制此文件为 .env，然后根据环境修改相应的值
# 注意：.env 文件包含敏感信息，请不要提交到 Git

# ===== 环境标识 =====
# 值必须是：dev, test, prod
RUN_MODE=dev

# 数据库密码（必须设置，不要使用硬编码的默认值）
DB_PASSWORD=your_password_here

# ===== 阿里云配置（可选） =====
# Python OSS SDK 从这些环境变量读取凭证
# 阿里云访问密钥ID
OSS_ACCESS_KEY_ID=

# 阿里云访问密钥密文
OSS_ACCESS_KEY_SECRET=

# ===== LLM 配置（可选） =====
# OpenAI API 密钥
OPENAI_API_KEY=

# OpenAI API 基础 URL
OPENAI_API_BASE=https://api.openai.com/v1
